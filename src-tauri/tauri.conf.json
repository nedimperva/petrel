{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petrel",
  "version": "0.1.0",
  "identifier": "io.github.nedimperva.petrel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Petrel",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; frame-src 'self' about: data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "rpm": {
        "desktopTemplate": "petrel.desktop"
      },
      "deb": {
        "desktopTemplate": "petrel.desktop",
        "depends": [
          "libwebkit2gtk-4.1-0"
        ]
      }
    }
  }
}
