{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main, capture and picker windows may do.",
  "windows": [
    "main",
    "capture",
    "picker"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:allow-open"
  ]
}
