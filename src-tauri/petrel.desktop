[Desktop Entry]
Type=Application
Name={{name}}
GenericName=Notes
Comment=Quick capture and notes, as Markdown files
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Terminal=false
Categories=Utility;TextEditor;Office;
Keywords=notes;capture;text;markdown;snippets;prompts;
Actions=capture;picker;

[Desktop Action capture]
Name=Capture
Exec={{exec}} --capture

[Desktop Action picker]
Name=Quick picker
Exec={{exec}} --picker
